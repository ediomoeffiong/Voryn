generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model City {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String @unique
  country     String
  countryCode String
  region      String
  timezone    String
  heroImage   String
  coordinates Json
}

model Organizer {
  id                   String @id @default(auto()) @map("_id") @db.ObjectId
  name                 String
  slug                 String @unique
  profileImage         String
  coverImage           String
  bio                  String
  website              String
  socials              Json
  followers            Int
  totalAttendeesHosted Int
}

model Event {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  title            String
  slug             String   @unique
  summary          String
  category         String
  type             String
  mode             String
  status           String
  startsAt         String
  venue            String
  citySlug         String
  country          String
  organizerSlug    String
  media            Json
  attendeeCount    Int
  rsvpCount        Int
  ticketSalesCount Int
  badges           String[]
  priceLabel       String
}

model User {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  email         String   @unique
  password      String
  role          String
  lastDashboard String   @default("participant")
  organizerSlug String?
  favorites     String[]
  following     String[]
  notifications Json
}

model Registration {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  userId       String
  eventSlug    String
  registeredAt String
  checkedIn    Boolean
  ticketCode   String
  reminders    Json
}

model Announcement {
  id            String @id @default(auto()) @map("_id") @db.ObjectId
  organizerSlug String
  eventSlug     String
  subject       String
  message       String
  sentAt        String
}

model Review {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  userId    String
  eventSlug String
  rating    Int
  comment   String
  createdAt String
}

model Session {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  token  String @unique
  userId String
}
