generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model City {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String @unique
  country     String
  countryCode String
  region      String
  timezone    String
  heroImage   String
  coordinates Json
}

model Organizer {
  id                   String   @id @default(auto()) @map("_id") @db.ObjectId
  name                 String
  slug                 String   @unique
  profileImage         String
  coverImage           String
  bio                  String
  website              String
  socials              Json
  followers            Int
  totalAttendeesHosted Int
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Event {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  title            String
  slug             String    @unique
  summary          String
  category         String
  type             String
  mode             String
  status           String
  startsAt         String
  venue            String
  citySlug         String
  country          String
  organizerSlug    String
  media            Json
  attendeeCount    Int
  rsvpCount        Int
  ticketSalesCount Int
  badges           String[]
  priceLabel       String
  capacity         Int?
  reservedCount    Int       @default(0)
  descriptionHtml  String?
  shortSummary     String?
  tags             String[]  @default([])
  language         String?   @default("en")
  targetAudience   String?
  visibility       String    @default("public")
  attendanceFormat String?   @default("physical")
  endsAt           DateTime?
  timezone         String?   @default("UTC")
  schedule         Json?
  recurrence       Json?
  location         Json?
  registration     Json?
  faqs             Json?
  speakers         Json?
  advancedSettings Json?
  publishAt        DateTime?
  publishedAt      DateTime?
  cancelledAt      DateTime?
  cancellationReason String?
  archivedAt       DateTime?
  trashedAt        DateTime?
  previousSlugs    String[]  @default([])
  version          Int       @default(1)
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([organizerSlug, status])
  @@index([citySlug, status])
  @@index([status, publishAt])
}

model TicketType {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  eventId               String   @db.ObjectId
  name                  String
  description           String
  currency              String
  priceMinor            Int
  capacity              Int?
  reservedCount         Int      @default(0)
  minPerOrder           Int      @default(1)
  maxPerOrder           Int      @default(1)
  salesOpenAt           DateTime?
  salesCloseAt          DateTime?
  visibility            String   @default("public")
  availability          String   @default("available")
  eligibility           String?
  sortOrder             Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([eventId, sortOrder])
}

model EventLifecycleLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  eventId   String   @db.ObjectId
  actorId   String   @db.ObjectId
  action    String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([eventId, createdAt])
}

model MediaAsset {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  ownerId     String   @db.ObjectId
  eventId     String?  @db.ObjectId
  storageKey  String   @unique
  url         String
  mimeType    String
  sizeBytes   Int
  altText     String
  originalName String
  createdAt   DateTime @default(now())
  deletedAt   DateTime?

  @@index([ownerId, createdAt])
  @@index([eventId])
}

model User {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  name                  String
  email                 String   @unique
  passwordHash          String   @map("password")
  role                  String
  lastDashboard         String   @default("participant")
  organizerSlug         String?
  favorites             String[]
  following             String[]
  notifications         Json
  profileImage          String?
  passwordResetRequired Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([role])
}

model Registration {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  userId       String
  eventSlug    String
  registeredAt String
  checkedIn    Boolean
  ticketCode   String
  reminders    Json
  status       String  @default("active")
  cancelledAt  String?
  eventId      String? @db.ObjectId
  ticketTypeId String? @db.ObjectId
  quantity     Int     @default(1)
  answers      Json?
  approvalStatus String @default("approved")
  paymentStatus  String @default("not_required")

  @@unique([userId, eventSlug])
  @@index([eventSlug, status])
}

model Announcement {
  id            String @id @default(auto()) @map("_id") @db.ObjectId
  organizerSlug String
  eventSlug     String
  subject       String
  message       String
  sentAt        String
}

model Review {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  userId    String
  eventSlug String
  rating    Int
  comment   String
  createdAt String
}

model Session {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tokenHash String   @unique @map("token")
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}
