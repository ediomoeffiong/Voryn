generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model City {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String @unique
  country     String
  countryCode String
  region      String
  timezone    String
  heroImage   String
  coordinates Json
}

model Organizer {
  id                   String   @id @default(auto()) @map("_id") @db.ObjectId
  name                 String
  slug                 String   @unique
  profileImage         String
  coverImage           String
  bio                  String
  website              String
  socials              Json
  followers            Int
  totalAttendeesHosted Int
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Event {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  title            String
  slug             String    @unique
  summary          String
  category         String
  type             String
  mode             String
  status           String
  startsAt         String
  venue            String
  citySlug         String
  country          String
  organizerSlug    String
  media            Json
  attendeeCount    Int
  rsvpCount        Int
  ticketSalesCount Int
  badges           String[]
  priceLabel       String
  capacity         Int?
  reservedCount    Int       @default(0)
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([organizerSlug, status])
  @@index([citySlug, status])
}

model User {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  name                  String
  email                 String   @unique
  passwordHash          String   @map("password")
  role                  String
  lastDashboard         String   @default("participant")
  organizerSlug         String?
  favorites             String[]
  following             String[]
  notifications         Json
  profileImage          String?
  passwordResetRequired Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([role])
}

model Registration {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  userId       String
  eventSlug    String
  registeredAt String
  checkedIn    Boolean
  ticketCode   String
  reminders    Json
  status       String  @default("active")
  cancelledAt  String?

  @@unique([userId, eventSlug])
  @@index([eventSlug, status])
}

model Announcement {
  id            String @id @default(auto()) @map("_id") @db.ObjectId
  organizerSlug String
  eventSlug     String
  subject       String
  message       String
  sentAt        String
}

model Review {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  userId    String
  eventSlug String
  rating    Int
  comment   String
  createdAt String
}

model Session {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tokenHash String   @unique @map("token")
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}
