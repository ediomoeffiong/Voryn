generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model City {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String @unique
  country     String
  countryCode String
  region      String
  timezone    String
  heroImage   String
  coordinates Json
}

model Organizer {
  id                   String   @id @default(auto()) @map("_id") @db.ObjectId
  name                 String
  slug                 String   @unique
  profileImage         String
  coverImage           String
  bio                  String
  website              String
  socials              Json
  followers            Int
  totalAttendeesHosted Int
  verificationStatus   String   @default("unverified")
  accountStatus        String   @default("active")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Event {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  title            String
  slug             String    @unique
  summary          String
  category         String
  type             String
  mode             String
  status           String
  startsAt         String
  venue            String
  citySlug         String
  country          String
  organizerSlug    String
  media            Json
  attendeeCount    Int
  rsvpCount        Int
  ticketSalesCount Int
  badges           String[]
  priceLabel       String
  capacity         Int?
  reservedCount    Int       @default(0)
  descriptionHtml  String?
  shortSummary     String?
  tags             String[]  @default([])
  language         String?   @default("en")
  targetAudience   String?
  visibility       String    @default("public")
  attendanceFormat String?   @default("physical")
  endsAt           DateTime?
  timezone         String?   @default("UTC")
  schedule         Json?
  recurrence       Json?
  location         Json?
  registration     Json?
  faqs             Json?
  speakers         Json?
  advancedSettings Json?
  publishAt        DateTime?
  publishedAt      DateTime?
  cancelledAt      DateTime?
  cancellationReason String?
  archivedAt       DateTime?
  trashedAt        DateTime?
  previousSlugs    String[]  @default([])
  version          Int       @default(1)
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([organizerSlug, status])
  @@index([citySlug, status])
  @@index([status, publishAt])
}

model TicketType {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  eventId               String   @db.ObjectId
  name                  String
  description           String
  currency              String
  priceMinor            Int
  capacity              Int?
  reservedCount         Int      @default(0)
  minPerOrder           Int      @default(1)
  maxPerOrder           Int      @default(1)
  salesOpenAt           DateTime?
  salesCloseAt          DateTime?
  visibility            String   @default("public")
  availability          String   @default("available")
  eligibility           String?
  sortOrder             Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([eventId, sortOrder])
}

model EventLifecycleLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  eventId   String   @db.ObjectId
  actorId   String   @db.ObjectId
  action    String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([eventId, createdAt])
}

model MediaAsset {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  ownerId     String   @db.ObjectId
  eventId     String?  @db.ObjectId
  storageKey  String   @unique
  url         String
  mimeType    String
  sizeBytes   Int
  altText     String
  originalName String
  createdAt   DateTime @default(now())
  deletedAt   DateTime?

  @@index([ownerId, createdAt])
  @@index([eventId])
}

model User {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  name                  String
  email                 String   @unique
  passwordHash          String   @map("password")
  role                  String
  lastDashboard         String   @default("participant")
  organizerSlug         String?
  favorites             String[]
  following             String[]
  notifications         Json
  profileImage          String?
  accountStatus         String   @default("active")
  interests             String[] @default([])
  locationPreferences   Json?
  lastActiveAt          DateTime?
  passwordResetRequired Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([role])
}

model Registration {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  userId       String
  eventSlug    String
  registeredAt String
  checkedIn    Boolean
  ticketCode   String
  reminders    Json
  status       String  @default("active")
  cancelledAt  String?
  eventId      String? @db.ObjectId
  ticketTypeId String? @db.ObjectId
  quantity     Int     @default(1)
  answers      Json?
  approvalStatus String @default("approved")
  paymentStatus  String @default("not_required")
  statusReason   String?
  updatedAt      DateTime @updatedAt

  @@unique([userId, eventSlug])
  @@index([eventSlug, status, approvalStatus])
  @@index([userId, status])
  @@index([ticketCode])
}

model Announcement {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  organizerSlug   String
  eventSlug       String
  subject         String
  message         String
  audience        String   @default("confirmed")
  status          String   @default("draft")
  deliveryProvider String?
  recipientCount  Int      @default(0)
  scheduledAt     DateTime?
  sentAt          String?
  createdById     String?  @db.ObjectId
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizerSlug, createdAt])
  @@index([eventSlug, status])
}

model Ticket {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  registrationId String   @unique @db.ObjectId
  eventId        String   @db.ObjectId
  ticketTypeId   String?  @db.ObjectId
  codeHash       String   @unique
  displayCode    String   @unique
  status         String   @default("valid")
  issuedAt       DateTime @default(now())
  invalidatedAt  DateTime?

  @@index([eventId, status])
}

model CheckIn {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  registrationId String   @db.ObjectId
  ticketId       String   @db.ObjectId
  eventId        String   @db.ObjectId
  actorId        String   @db.ObjectId
  action         String
  reason         String?
  occurredAt     DateTime @default(now())

  @@index([registrationId, occurredAt])
  @@index([eventId, occurredAt])
}

model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  category  String
  title     String
  message   String
  eventSlug String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, readAt, createdAt])
}

model ModerationReport {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  reporterId     String   @db.ObjectId
  resourceType   String
  resourceId     String
  category       String
  description    String
  evidence       Json?
  priority       String   @default("normal")
  status         String   @default("open")
  assignedToId   String?  @db.ObjectId
  resolution     String?
  resolvedById   String?  @db.ObjectId
  resolvedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, priority, createdAt])
  @@index([reporterId, createdAt])
  @@index([resourceType, resourceId])
}

model AuditLog {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  actorId       String   @db.ObjectId
  action        String
  resourceType  String
  resourceId    String
  metadata      Json?
  correlationId String?
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([resourceType, resourceId, createdAt])
}

model PlatformSetting {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  key         String   @unique
  value       Json
  description String?
  updatedById String   @db.ObjectId
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model OrganizerVerification {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  organizerId   String   @db.ObjectId
  status        String   @default("pending")
  notes         String?
  reviewedById  String?  @db.ObjectId
  reviewedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([organizerId, createdAt])
  @@index([status, createdAt])
}

model Review {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  userId    String
  eventSlug String
  rating    Int
  comment   String
  createdAt String
}

model Session {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tokenHash String   @unique @map("token")
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}
